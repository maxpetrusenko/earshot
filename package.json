{
  "name": "@maxpetrusenko/earshot",
  "version": "1.0.0",
  "description": "Hear what your coding agent did: ear-first voice memos and glance diagrams for Claude Code, Codex and MCP.",
  "type": "module",
  "bin": {
    "earshot": "dist/cli.js",
    "earshot-hook": "dist/hook-entry.js"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "beautiful-mermaid": "1.1.3",
    "commander": "^15.1.0",
    "langfuse": "^3.39.2",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "assets",
    "prompts",
    "integrations",
    "config.example.yaml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxpetrusenko/earshot.git"
  },
  "homepage": "https://github.com/maxpetrusenko/earshot#readme",
  "bugs": {
    "url": "https://github.com/maxpetrusenko/earshot/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "mcp",
    "tts",
    "voice",
    "ai-agents",
    "developer-tools"
  ],
  "author": "Max Petrusenko"
}
